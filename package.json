{
  "name": "tross-linkedin-profile-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-style LinkedIn profile extraction API for the Tross engineering challenge",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "NODE_OPTIONS=--env-file-if-exists=.env tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
